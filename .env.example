# Local runs (uv run arb) use localhost; Compose overrides this for the container.
DATABASE_URL=postgresql://arb:arb@localhost:5432/arb
POSTGRES_USER=arb
POSTGRES_PASSWORD=arb
POSTGRES_DB=arb

# Measurement mode (recommended while collecting data): zero fees + a 1 bp threshold records
# every episode whose GROSS edge exceeds 1 bp. Apply your real fees afterwards with
#   uv run arb-report --fee coinbase=<rate> --fee okx=<rate>
# Fractions throughout: 0.001 = 0.1% = 10 bps. Every stored row records the values used here.
COINBASE_TAKER_FEE=0
OKX_TAKER_FEE=0
EXTRA_COST=0
MIN_NET_EDGE=0.0001
# Sizes in quote currency (USDC), so they mean the same for every coin: the probe size (the
# edge a tiny trade would see) and a generous cap for measuring how much size is executable
PROBE_NOTIONAL=100
DETECT_NOTIONAL=100000
COINBASE_STALE_MS=1500
OKX_STALE_MS=3000

LOG_LEVEL=INFO
BASE_ASSET=BTC
COINBASE_QUOTE=USDC
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
WS_READ_TIMEOUT_S=10
OKX_QUOTE=USDC
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com

# Persist episodes to Postgres (needs the database up). EPOCH tags every stored row.
PERSIST=false
EPOCH=dev
MONITOR_INTERVAL_S=5
